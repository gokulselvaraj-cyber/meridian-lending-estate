<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <changeSet id="002-add-ltv-column" author="data-platform">
        <comment>Store each loan's loan-to-value at disbursement. Existing rows were filled by platform/tools/backfill_ltv.py.</comment>
        <addColumn tableName="LOAN">
            <column name="ltv_ratio" type="NUMERIC(5,4)"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
