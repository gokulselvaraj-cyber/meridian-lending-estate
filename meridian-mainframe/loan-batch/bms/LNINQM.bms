LNINQM   DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,TIOAPFX=YES,       X
               STORAGE=AUTO,CTRL=(FREEKB,FRSET)
LNINQM   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,25),LENGTH=28,ATTRB=(ASKIP,BRT),                X
               INITIAL='MERIDIAN LENDING - LOAN ENQUIRY'
         DFHMDF POS=(4,2),LENGTH=16,ATTRB=ASKIP,INITIAL='LOAN ACCOUNT NO'
ACCT     DFHMDF POS=(4,20),LENGTH=10,ATTRB=(UNPROT,IC)
         DFHMDF POS=(6,2),LENGTH=16,ATTRB=ASKIP,INITIAL='OUTSTANDING'
BAL      DFHMDF POS=(6,20),LENGTH=16,ATTRB=ASKIP
         DFHMDF POS=(7,2),LENGTH=16,ATTRB=ASKIP,INITIAL='ACCRUED INTEREST'
INT      DFHMDF POS=(7,20),LENGTH=16,ATTRB=ASKIP
         DFHMDF POS=(8,2),LENGTH=16,ATTRB=ASKIP,INITIAL='STATUS'
STAT     DFHMDF POS=(8,20),LENGTH=12,ATTRB=ASKIP
MSG      DFHMDF POS=(22,2),LENGTH=60,ATTRB=(ASKIP,BRT)
         DFHMSD TYPE=FINAL
         END
