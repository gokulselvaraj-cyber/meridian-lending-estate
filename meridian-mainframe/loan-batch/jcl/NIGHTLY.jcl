//NIGHTLY  JOB (LEND),'LENDING NIGHTLY',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID
//*****************************************************************
//* MERIDIAN LENDING NIGHTLY BATCH                                *
//* STEP010 ACCRUE01  INTEREST ACCRUAL                            *
//* STEP020 LATEFEE1  LATE FEES (PARAMETERS FROM ACCRPARM)        *
//* STEP030 STMTGEN1  DAILY STATEMENTS                            *
//* MERIDIAN.LENDING.STMT.DAILY IS PICKED UP BY THE FILE TRANSFER *
//* AND LANDED AT /data/stmt/daily.dat FOR NOTIFY-SVC.            *
//*****************************************************************
//STEP010  EXEC PGM=ACCRUE01
//STEPLIB  DD DSN=MERIDIAN.LENDING.LOADLIB,DISP=SHR
//ACCROUT  DD DSN=MERIDIAN.LENDING.ACCRUAL.DAILY,
//            DISP=(NEW,CATLG,DELETE),SPACE=(CYL,(10,5)),
//            DCB=(RECFM=FB,LRECL=150)
//SYSOUT   DD SYSOUT=*
//*
//STEP020  EXEC PGM=LATEFEE1,COND=(4,LT,STEP010)
//STEPLIB  DD DSN=MERIDIAN.LENDING.LOADLIB,DISP=SHR
//PARMIN   DD DSN=MERIDIAN.LENDING.PARMLIB(ACCRPARM),DISP=SHR
//SYSOUT   DD SYSOUT=*
//*
//STEP030  EXEC PGM=STMTGEN1,COND=(4,LT,STEP020)
//STEPLIB  DD DSN=MERIDIAN.LENDING.LOADLIB,DISP=SHR
//ACCRIN   DD DSN=MERIDIAN.LENDING.ACCRUAL.DAILY,DISP=(OLD,DELETE)
//STMTOUT  DD DSN=MERIDIAN.LENDING.STMT.DAILY,
//            DISP=(NEW,CATLG,DELETE),SPACE=(CYL,(10,5)),
//            DCB=(RECFM=FB,LRECL=80)
//SYSOUT   DD SYSOUT=*
